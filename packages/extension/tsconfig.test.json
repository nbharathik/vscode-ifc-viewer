{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2022"],
    "types": ["node", "vscode", "mocha"],
    "outDir": "out-test",
    "rootDir": "src",
    "noEmit": false,
    "sourceMap": true,
    "isolatedModules": false
  },
  "include": ["src/test/**/*.ts", "src/protocol.ts"],
  "exclude": ["node_modules", "dist"]
}
